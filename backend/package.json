{
  "name": "kitlisto-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KitListo · servicio de inventario (libro mayor, reservas, faltantes)",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "node --env-file=.env --watch src/main.ts",
    "start": "node --env-file=.env src/main.ts",
    "migrate": "node --env-file=.env src/scripts/migrate.ts",
    "reset": "node --env-file=.env src/scripts/migrate.ts --reset",
    "check:contract": "node --env-file=.env src/scripts/check-contract.ts",
    "replay": "node --env-file=.env src/replay/file.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "express": "5.1.0",
    "kafkajs": "2.2.4",
    "pg": "8.16.3"
  }
}
